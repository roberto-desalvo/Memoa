<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Memoa.Transcriber</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <!-- Motore Parakeet (ONNX Runtime su CPU) e VAD Silero; include le librerie native. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <!-- Motore Whisper e, con Parakeet, rilevamento della lingua con Whisper tiny. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- Runtime nativo di whisper.cpp per CPU. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Memoa.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Script del motore faster-whisper, avviato da FasterWhisperEngine accanto al worker. -->
    <None Include="FasterWhisper\transcribe.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
