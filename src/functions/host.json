{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "extensions": {
    "queues": {
      "maxDequeueCount": 5
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function": "Information",
      "Host.Results": "Information",
      "Host.Aggregator": "Warning"
    }
  }
}
