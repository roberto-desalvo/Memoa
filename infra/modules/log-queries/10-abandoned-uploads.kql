// Upload autorizzati, annullati dal client dopo un errore e scaduti senza file, per giorno e tipo (audio o file di
// testo). Annullamenti e scadenze registrati prima dei file di testo non hanno SourceType: sono audio.
AppTraces
| extend Categoria = tostring(Properties.CategoryName)
| extend Esito = case(
    Categoria endswith ".CreateAudioUploadFunction", "Autorizzato",
    Categoria endswith ".CreateDocumentUploadFunction", "Autorizzato",
    Categoria endswith ".CancelAudioUploadFunction", "Annullato dal client",
    Categoria endswith ".ExpireAudioUploadFunction" and Message has "mai completato", "Scaduto senza file",
    "")
| where isnotempty(Esito)
| extend Tipo = iff(Categoria endswith ".CreateDocumentUploadFunction" or tostring(Properties.SourceType) == "Text", "file di testo", "audio")
| extend Esito = strcat(Esito, " (", Tipo, ")")
| summarize Upload = count() by bin(TimeGenerated, 1d), Esito
| render columnchart
