# Modello di infra/.env: copiarlo in infra/.env e compilarlo. Questo file si committa, .env no.
# Caricare con: . .\infra\load-env.ps1

SQL_SERVER_RESOURCE_GROUP=
SQL_SERVER_NAME=

# PAT GitHub con scope read:packages, solo se l'immagine del worker su GHCR è privata.
GHCR_TOKEN=

# Entra External ID: authority del tenant esterno e client ID della registrazione dell'API per ambiente.
# Es. AUTH_AUTHORITY=https://<sottodominio>.ciamlogin.com/<tenant-id>/v2.0
AUTH_AUTHORITY=
AUTH_AUDIENCE_DEV=
AUTH_AUDIENCE_PROD=
