# Modello di infra/.env: copiarlo in infra/.env e compilarlo. Questo file si committa, .env no.
# Caricare con: . .\infra\load-env.ps1

SQL_SERVER_RESOURCE_GROUP=
SQL_SERVER_NAME=

# PAT GitHub con scope read:packages, solo se l'immagine del worker su GHCR è privata.
GHCR_TOKEN=

# Entra External ID: un tenant esterno per ambiente. L'authority si compila a mano.
# Es. AUTH_AUTHORITY_DEV=https://<sottodominio>.ciamlogin.com/<tenant-id>/v2.0
AUTH_AUTHORITY_DEV=
AUTH_AUTHORITY_PROD=

# Scritte da infra/identity/deploy.ps1 (client ID dell'API, client ID del frontend, scope dell'API).
AUTH_AUDIENCE_DEV=
AUTH_AUDIENCE_PROD=
AUTH_WEB_CLIENT_ID_DEV=
AUTH_WEB_CLIENT_ID_PROD=
AUTH_API_SCOPE_DEV=
AUTH_API_SCOPE_PROD=

# Object ID (separati da virgola) degli utenti che eseguono le Functions in locale contro dev.
# Ricevono sullo storage dei dati gli stessi ruoli delle Functions. Il proprio: az ad signed-in-user show --query id -o tsv
DEVELOPER_PRINCIPAL_IDS_DEV=

# Immagine del job di normalizzazione per il deploy dell'infrastruttura, dopo la prima pubblicazione su GHCR.
# Es. ghcr.io/<owner>/memoa-normalizer:main (dev) e :prod (prod). Vuote: immagine segnaposto.
NORMALIZER_IMAGE_DEV=
NORMALIZER_IMAGE_PROD=

# Immagine del job di trascrizione, come sopra. Es. ghcr.io/<owner>/memoa-transcriber:main (dev) e :prod (prod).
TRANSCRIBER_IMAGE_DEV=
TRANSCRIBER_IMAGE_PROD=
