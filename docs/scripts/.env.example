# Modello di docs/scripts/.env per gli script di simulazione degli eventi (vedi docs/sviluppo-locale.md).
# Copiarlo in docs/scripts/.env e compilarlo. Questo file si committa, .env no.
# Le variabili vuote prendono il valore predefinito dello script.

# Obbligatorie: storage dei dati dev e identificativi del record (percorso <oid>/<recordId> del blob).
DATA_STORAGE_ACCOUNT=
USER_OID=
RECORD_ID=

# send-blob-created-event.ps1 (ValidateUpload). Predefiniti: 391502, audio/webm;codecs=opus
UPLOAD_SIZE=
UPLOAD_CONTENT_TYPE=

# upload-normalized-blob.ps1 e send-normalized-event.ps1 (EnqueueTranscription).
# true: esito di errore (<recordId>.error.json); false o vuota: copia normalizzata (<recordId>.opus).
NORMALIZED_IS_ERROR=
# File .opus da caricare come copia normalizzata. Predefinito: .\prova.opus
NORMALIZED_OPUS_FILE=
# Predefiniti: 42, audio_too_long
NORMALIZED_DURATION_SECONDS=
NORMALIZED_ERROR_CODE=
# Solo send-normalized-event.ps1: nome del blob al posto di quello calcolato (es. abc.opus per un nome non valido).
NORMALIZED_BLOB_NAME=
